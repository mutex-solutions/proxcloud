#cloud-config
{
  "runcmd": [
    "set -eu",
    "curl -fsSL --retry 5 -o /usr/local/bin/k3s 'https://github.com/k3s-io/k3s/releases/download/v1.36.6%2Bk3s1/k3s'",
    "printf '%s  %s\\n' '66ceb8e67edfa547195135d74783bfadc2ecc04a91059e90ae5f70a3dbc98c15' /usr/local/bin/k3s | sha256sum -c -",
    "chmod 0755 /usr/local/bin/k3s",
    "curl -fsSL --retry 5 -o /run/proxcloud/install.sh 'https://raw.githubusercontent.com/k3s-io/k3s/v1.36.6%2Bk3s1/install.sh'",
    "printf '%s  %s\\n' '46177d4c99440b4c0311b67233823a8e8a2fc09693f6c89af1a7161e152fbfad' /run/proxcloud/install.sh | sha256sum -c -",
    "INSTALL_K3S_SKIP_DOWNLOAD=true INSTALL_K3S_VERSION='v1.36.6+k3s1' sh /run/proxcloud/install.sh",
    "timeout 600 sh -c 'until k3s kubectl get --raw /readyz >/dev/null 2>&1; do sleep 5; done'",
    "k3s kubectl apply -f /run/proxcloud/bootstrap.yaml",
    "rm -f /run/proxcloud/bootstrap.yaml /run/proxcloud/install.sh",
    "touch /etc/cloud/cloud-init.disabled"
  ],
  "write_files": [
    {
      "content": "-----BEGIN CERTIFICATE-----\nPLANT-ca-cert\n-----END CERTIFICATE-----\n",
      "owner": "root:root",
      "path": "/var/lib/rancher/k3s/server/tls/server-ca.crt",
      "permissions": "0644"
    },
    {
      "content": "-----BEGIN EC PRIVATE KEY-----\nPLANT-ca-key-0004\n-----END EC PRIVATE KEY-----\n",
      "owner": "root:root",
      "path": "/var/lib/rancher/k3s/server/tls/server-ca.key",
      "permissions": "0600"
    },
    {
      "content": "{\n  \"cluster-init\": true,\n  \"disable\": [\n    \"traefik\",\n    \"servicelb\",\n    \"local-storage\"\n  ],\n  \"kube-apiserver-arg\": [\n    \"anonymous-auth=false\",\n    \"enable-bootstrap-token-auth=true\"\n  ],\n  \"node-ip\": \"192.0.2.5\",\n  \"secrets-encryption\": true,\n  \"tls-san\": [\n    \"192.0.2.5\"\n  ],\n  \"token\": \"PLANT-k3s-token-0005\",\n  \"write-kubeconfig-mode\": \"0600\"\n}\n",
      "owner": "root:root",
      "path": "/etc/rancher/k3s/config.yaml",
      "permissions": "0600"
    },
    {
      "content": "{\n  \"apiVersion\": \"v1\",\n  \"items\": [\n    {\n      \"apiVersion\": \"v1\",\n      \"kind\": \"Namespace\",\n      \"metadata\": {\n        \"name\": \"proxcloud-system\"\n      }\n    },\n    {\n      \"apiVersion\": \"v1\",\n      \"kind\": \"ServiceAccount\",\n      \"metadata\": {\n        \"name\": \"proxcloud-portal\",\n        \"namespace\": \"proxcloud-system\"\n      }\n    },\n    {\n      \"apiVersion\": \"rbac.authorization.k8s.io/v1\",\n      \"kind\": \"ClusterRoleBinding\",\n      \"metadata\": {\n        \"name\": \"proxcloud-portal\"\n      },\n      \"roleRef\": {\n        \"apiGroup\": \"rbac.authorization.k8s.io\",\n        \"kind\": \"ClusterRole\",\n        \"name\": \"cluster-admin\"\n      },\n      \"subjects\": [\n        {\n          \"kind\": \"ServiceAccount\",\n          \"name\": \"proxcloud-portal\",\n          \"namespace\": \"proxcloud-system\"\n        }\n      ]\n    },\n    {\n      \"apiVersion\": \"v1\",\n      \"kind\": \"Secret\",\n      \"metadata\": {\n        \"annotations\": {\n          \"kubernetes.io/service-account.name\": \"proxcloud-portal\"\n        },\n        \"name\": \"proxcloud-portal-token-g1\",\n        \"namespace\": \"proxcloud-system\"\n      },\n      \"type\": \"kubernetes.io/service-account-token\"\n    },\n    {\n      \"apiVersion\": \"v1\",\n      \"kind\": \"Secret\",\n      \"metadata\": {\n        \"name\": \"bootstrap-token-plant7\",\n        \"namespace\": \"kube-system\"\n      },\n      \"stringData\": {\n        \"auth-extra-groups\": \"system:bootstrappers:proxcloud\",\n        \"description\": \"ProxCloud portal: reads proxcloud-system/proxcloud-portal-token-g1 once\",\n        \"expiration\": \"2026-11-15T13:00:00Z\",\n        \"token-id\": \"plant7\",\n        \"token-secret\": \"plant0bootstrap6\",\n        \"usage-bootstrap-authentication\": \"true\"\n      },\n      \"type\": \"bootstrap.kubernetes.io/token\"\n    },\n    {\n      \"apiVersion\": \"rbac.authorization.k8s.io/v1\",\n      \"kind\": \"Role\",\n      \"metadata\": {\n        \"name\": \"proxcloud-bootstrap\",\n        \"namespace\": \"proxcloud-system\"\n      },\n      \"rules\": [\n        {\n          \"apiGroups\": [\n            \"\"\n          ],\n          \"resourceNames\": [\n            \"proxcloud-portal-token-g1\"\n          ],\n          \"resources\": [\n            \"secrets\"\n          ],\n          \"verbs\": [\n            \"get\"\n          ]\n        }\n      ]\n    },\n    {\n      \"apiVersion\": \"rbac.authorization.k8s.io/v1\",\n      \"kind\": \"RoleBinding\",\n      \"metadata\": {\n        \"name\": \"proxcloud-bootstrap\",\n        \"namespace\": \"proxcloud-system\"\n      },\n      \"roleRef\": {\n        \"apiGroup\": \"rbac.authorization.k8s.io\",\n        \"kind\": \"Role\",\n        \"name\": \"proxcloud-bootstrap\"\n      },\n      \"subjects\": [\n        {\n          \"apiGroup\": \"rbac.authorization.k8s.io\",\n          \"kind\": \"Group\",\n          \"name\": \"system:bootstrappers:proxcloud\"\n        }\n      ]\n    }\n  ],\n  \"kind\": \"List\"\n}\n",
      "owner": "root:root",
      "path": "/run/proxcloud/bootstrap.yaml",
      "permissions": "0600"
    }
  ]
}
