# Copy to `.env` and set your Keycloak issuer(s). Only these vars are read by
# docker-compose.yml.

# ─── OIDC / Keycloak — required for authenticated routes ─────────────────────────
# Issuer = browser-facing Keycloak URL (the token `iss`), also reachable from the
# api container for JWKS. Empty ⇒ realm off ⇒ its tokens 401 (login works, API 401).

# Customer console — `clients` realm:
PROXCLOUD_OAUTH2_ISSUER=https://id.example.com/realms/clients
PROXCLOUD_OAUTH2_CLIENT_ID=proxcloud-ui

# Operator / admin console — `master` realm:
PROXCLOUD_ADMIN_OAUTH2_ISSUER=https://id.example.com/realms/master
PROXCLOUD_ADMIN_OAUTH2_CLIENT_ID=proxcloud-admin

# Machine Admin API — defaults to the admin issuer + `proxcloud-admin-api`; override:
# PROXCLOUD_ADMIN_API_OAUTH2_ISSUER=https://id.example.com/realms/master
# PROXCLOUD_ADMIN_API_OAUTH2_CLIENT_ID=proxcloud-admin-api

# ─── Cloud — optional ─────────────────────────────────────────────────────────────
# Region assumed when a provider names none (default "default"):
# PROXCLOUD_DEFAULT_REGION=default
