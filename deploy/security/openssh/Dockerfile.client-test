# DISPOSABLE HOSTED TEST IMAGE ONLY. Not a product/runtime/export stage.
# Parent verifies the built artifact SHA256 against retained build evidence, then
# copies ONLY that .deb to client-package/openssh-client.deb in this build context.
# No named contexts, credentials, host keys, bind mounts, image pushes or promotion.
# Build (future hosted runner only):
# docker build -f deploy/security/openssh/Dockerfile.client-test \
#   -t openssh-client-test deploy/security/openssh
# Run with an OUTER hosted-job timeout as well as the script's 180-second alarm:
# docker run --rm --network none --user 1000:1000 --cap-drop ALL \
#   --security-opt no-new-privileges --pids-limit 128 --memory 1g --cpus 2 \
#   --read-only --tmpfs /tmp:rw,nosuid,nodev,mode=1777 openssh-client-test
FROM debian:trixie-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 PATH=/usr/bin:/bin
# Suppress service autostart BEFORE any package installation. The distro server
# is only a disposable loopback fixture; its dependencies are NOT CVE clearance.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssh-server openssh-client python3 \
    && useradd --uid 1000 --create-home --shell /bin/sh --password NP testclient \
    && mkdir -p /run/sshd
# NP is an invalid, non-locked password marker, NOT a usable credential.
# Password and keyboard-interactive authentication are also disabled in sshd.
COPY client-package/openssh-client.deb /tmp/openssh-client.deb
# Install the complete built client package, including Debian helpers/metadata;
# do not cherry-pick binaries, strip GSS support, or fetch dependencies afterward.
RUN test "$(dpkg-deb -f /tmp/openssh-client.deb Package)" = openssh-client \
    && test "$(dpkg-deb -f /tmp/openssh-client.deb Version)" = '1:10.0p1-7+deb13u4+proxcloud1' \
    && test "$(dpkg-deb -f /tmp/openssh-client.deb Architecture)" = amd64 \
    && dpkg -i /tmp/openssh-client.deb \
    && test "$(dpkg-query -W -f='${Version}' openssh-client)" = '1:10.0p1-7+deb13u4+proxcloud1'
COPY test-client.py /opt/openssh-client-test.py
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/openssh-client-test.py"]
