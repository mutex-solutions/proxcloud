# SOURCE_CANDIDATE — source-only, NONDEFAULT prototype; not approved or published.
# Manual build context: deploy/templates; select this Dockerfile explicitly.
# Parent must freshly verify official amd64 manifest/config digests before build/push.
# Parent's saved receipt verifies Python linux/amd64 manifest b701... and config
# 896edfbcbf0c29ad15681617a8886cb9871b7f24c5fde4606114c8ee6bfe4c70:
# PYTHON_VERSION=3.11.18; metadata only, no layer/runtime execution evidence.
# Node donor was previously verified as 22.23.5; assertions below are build gates,
# not a claim this unbuilt prototype has validated runtime versions.
FROM docker.io/library/node:22-bookworm-slim@sha256:47725aca53d3295ec2d3be8f62726599b3033cc262edc2c7e429909b3ac599fc AS node-toolchain
FROM golang:1.27.4-alpine AS gh-builder
ENV GOTOOLCHAIN=local \
    CGO_ENABLED=0 \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org \
    GOPRIVATE= \
    GONOSUMDB= \
    GONOPROXY= \
    GIT_TERMINAL_PROMPT=0
RUN apk add --no-cache ca-certificates git
WORKDIR /src
# No ARG/ENV source selector: neither a build argument nor a moving tag can
# substitute a different commit. Verify the checkout before executing Go tools.
RUN set -eu; \
    git clone --no-checkout https://github.com/cli/cli.git cli; \
    cd cli; \
    git checkout --detach 63837fb778d6a39f02be0ce76ff89f2bc8d74bdc; \
    test "$(git rev-parse HEAD)" = 63837fb778d6a39f02be0ce76ff89f2bc8d74bdc; \
    printf '%s  %s\n' db11ba3547fe6420c763b5fb208bb5e41a44598895f94481be01ea967fc421e2 go.mod \
        | sha256sum -c -; \
    test -z "$(git status --porcelain)"; \
    mkdir -p /out/upstream /out/modified; \
    git rev-parse HEAD > /out/source-commit.txt; \
    cp go.mod go.sum /out/upstream/
WORKDIR /src/cli
# The hash above locks the reviewed v0.60.0 graph. Fail rather than silently
# downgrade/change a different source graph. MVS changes remain in the diff.
RUN set -eu; \
    test "$(go list -m -f '{{.Version}}' golang.org/x/net)" = v0.60.0; \
    go mod edit -require=golang.org/x/net@v0.62.0; \
    go mod tidy; \
    test "$(go list -m -f '{{.Version}}' golang.org/x/net)" = v0.62.0; \
    go mod verify > /out/module-verification.txt; \
    cp go.mod go.sum /out/modified/; \
    git diff --exit-code -- . ':!go.mod' ':!go.sum'; \
    git diff -- go.mod go.sum > /out/source-dependency-diff.patch; \
    test -s /out/source-dependency-diff.patch; \
    go list -mod=readonly -m -json all > /out/modules.json; \
    go version > /out/toolchain.txt
# Limited upstream unit gates, not the full suite or CVE/network acceptance.
# These commands run ONLY in a future authorized image build.
RUN set -eu; \
    go test -mod=readonly ./internal/build ./internal/ghrepo golang.org/x/net/html > /out/unit-tests.txt; \
    go build -mod=readonly -trimpath -buildvcs=false \
        -ldflags='-s -w -X github.com/cli/cli/v2/internal/build.Version=2.103.3+proxcloud1' \
        -o /out/gh ./cmd/gh; \
    go version -m /out/gh > /out/go-buildinfo.txt; \
    awk '$1 == "dep" && $2 == "golang.org/x/net" && $3 == "v0.62.0" { found=1 } END { exit !found }' \
        /out/go-buildinfo.txt; \
    mkdir -p /tmp/gh-empty-home; \
    HOME=/tmp/gh-empty-home GH_CONFIG_DIR=/tmp/gh-empty-home GH_NO_UPDATE_NOTIFIER=1 \
        GH_NO_EXTENSION_UPDATE_NOTIFIER=1 /out/gh --version > /out/gh-version.txt; \
    case "$(head -n 1 /out/gh-version.txt)" in \
        'gh version 2.103.3+proxcloud1'*) ;; \
        *) exit 1 ;; \
    esac; \
    cp LICENSE /out/LICENSE; \
    printf '%s\n' \
        'SOURCE_BUILD_CANDIDATE_NOT_RUNTIME_SECURITY_VALIDATED' \
        'Upstream: https://github.com/cli/cli.git' \
        'Commit: 63837fb778d6a39f02be0ce76ff89f2bc8d74bdc (v2.103.3)' \
        'Local version: 2.103.3+proxcloud1; not the official release binary.' \
        'Modification: x/net v0.60.0 -> v0.62.0, followed by go mod tidy.' \
        'Review source-dependency-diff.patch for all resulting module changes.' \
        'Upstream MIT LICENSE retained. Module/license inventory review required.' \
        'modules.json is a module inventory, NOT a complete SPDX/CycloneDX SBOM.' \
        'Fresh artifact/stdlib/module and integrated runtime scans are required.' \
        'No scanner suppressions, VEX waiver, runtime install, or promotion.' \
        > /out/SOURCE_BUILD_NOTICE.txt; \
    cd /out; \
    sha256sum gh LICENSE source-commit.txt source-dependency-diff.patch \
        upstream/go.mod upstream/go.sum modified/go.mod modified/go.sum \
        modules.json go-buildinfo.txt toolchain.txt unit-tests.txt \
        module-verification.txt gh-version.txt SOURCE_BUILD_NOTICE.txt > SHA256SUMS

FROM docker.io/library/python:3.11-slim-trixie@sha256:b701198cb708b68d9413ca67d6311bd97c9389a2c5fe4da0511fc652642366cd
USER root
# Bookworm-built Node requires glibc 2.36; Debian 13 provides glibc >=2.41.
# Copy only Node/npm; do not overwrite Python, OpenSSL, or the target OS libraries.
# Owner approved splitting inherited image/codec, XML/GLib, X11/Tk/Cairo,
# database/auth development and hg/svn groups into separate variants. This is
# NOT feature-equivalent to the old vendor base; default is unchanged until
# the documented core/SDK/MCP and security gates are accepted.
# Keep openssh-client; SSH/GSS authentication parity still needs acceptance tests.
# No CVE ignores or package/SBOM database removal; raw scanner findings may block.
RUN test "$(dpkg --print-architecture)" = amd64 \
 && apt-get update && apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates sudo git build-essential curl wget pkg-config \
      libstdc++6 openssh-client passwd util-linux patch xz-utils unzip zip tar bzip2 \
       tzdata fonts-dejavu-core \
      libsqlite3-dev libssl-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
# Upstream v2.103.3 retains the >=2.93.0 CVE-2026-48501 vendor fix.
# Local source rebuild pins x/net v0.62.0; integrated runtime scan still required.
# The legacy install-gh.sh remains unused provenance, not a runtime installer.
COPY --from=gh-builder /out/gh /usr/local/bin/gh
COPY --from=gh-builder /out/LICENSE /usr/local/share/doc/gh/LICENSE
# Retain official /usr/local Python 3.11 and its UTF-8 locale configuration.
RUN /usr/local/bin/python3 -m pip install --no-cache-dir --only-binary=:all: --no-deps --upgrade \
      pip==26.3 setuptools==84.2.1 wheel==0.48.0 packaging==26.3
COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
# Bootstrap npm/npx before install, then rebind after npm's self-upgrade:
# even --bin-links=false can remove the previous version's existing links.
RUN ln -sfn ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sfn ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install -g --bin-links=false npm@11.21.2 corepack@0.36.0 yarn@1.22.22 \
 && ln -sfn ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sfn ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -sfn ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
 && ln -sfn ../lib/node_modules/yarn/bin/yarn.js /usr/local/bin/yarn \
 && ln -sfn ../lib/node_modules/yarn/bin/yarn.js /usr/local/bin/yarnpkg \
 && npm cache clean --force \
 && test "$(node --version)" = v22.23.5 \
 && test "$(npm --version)" = 11.21.2 \
 && test "$(corepack --version)" = 0.36.0 \
 && test "$(yarn --version)" = 1.22.22
COPY common/setup-user.sh /usr/local/sbin/proxcloud-setup-user
RUN proxcloud-setup-user
COPY base/smoke-controlled.py /tmp/proxcloud-smoke-controlled.py
# Fixed, offline target-image checks, executed only by a future explicit CI build.
RUN timeout --kill-after=5s 90s /usr/local/bin/python3 /tmp/proxcloud-smoke-controlled.py \
 && rm /tmp/proxcloud-smoke-controlled.py
WORKDIR /home/user
# Acceptance before any controlled switch: all seven derived builds, SDK/MCP
# integration, optional-feature inventory, and raw SBOM/scanner/security review.
# This smoke alone proves neither feature parity nor a zero-CVE image.
