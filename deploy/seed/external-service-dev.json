[
  {
    "_id": "svc-proxmox-dev",
    "name": "dev region",
    "type": "CLOUD",
    "status": "PUBLIC",
    "config": {
      "provider": "proxmox",
      "region": "RegionOne",
      "regions": {
        "RegionOne": { "name": "RegionOne", "country": "", "displayName": "" }
      },
      "services": {
        "compute":  { "RegionOne": true },
        "network":  { "RegionOne": true },
        "volumev3": { "RegionOne": true },
        "image":    { "RegionOne": true }
      },
      "apiUrl": "https://pve1.example.com:8006",
      "tokenId": "proxcloud@pve!platform",
      "fingerprint": "",
      "insecureTls": false,
      "poolPrefix": "pc-",
      "network": {
        "defaultZone": "simple",
        "zones": { "simple": { "kind": "simple" } },
        "cidrPool": "10.100.0.0/16"
      },
      "storageProfiles": {
        "std": { "storages": { "*": "local-zfs" }, "shared": false, "snapshots": true, "thin": true, "liveMigrate": false, "replication": false }
      },
      "defaultStorageProfile": "std",
      "metrics": { "source": "none" }
    },
    "secret": {
      "tokenSecret": "__PVE_TOKEN_SECRET__"
    }
  },
  {
    "_id": "svc-kamaji-dev",
    "name": "kamaji dev (managed kubernetes)",
    "type": "CLOUD",
    "status": "PRIVATE",
    "config": {
      "provider": "kamaji",
      "regions": {
        "RegionOne": { "name": "RegionOne", "country": "", "displayName": "" }
      },
      "services": {
        "kubernetes": { "RegionOne": true }
      },
      "argocd": {
        "namespace": "argocd",
        "project": "proxcloud-k8s",
        "chartRepo": "ghcr.io/mutex-solutions/charts",
        "chartName": "__KAMAJI_CLUSTER_CHART__",
        "chartVersion": "0.7.0"
      },
      "cluster": {
        "dataStoreName": "default",
        "dnsZone": "k8s.example.com",
        "versions": {
          "1.35.4": "__NODE_IMAGE_ID_1_35_4__"
        },
        "flavors": []
      }
    },
    "secret": {
      "kubeconfig": "__MGMT_CLUSTER_KUBECONFIG__"
    }
  },
  {
    "_id": "svc-dbaas-dev",
    "name": "dbaas dev (managed databases)",
    "type": "CLOUD",
    "status": "PRIVATE",
    "config": {
      "provider": "dbaas",
      "region": "RegionOne",
      "regions": {
        "RegionOne": { "name": "RegionOne", "country": "", "displayName": "" }
      },
      "services": {
        "database": { "RegionOne": true }
      },
      "argocd": {
        "namespace": "argocd",
        "project": "proxcloud-dbaas",
        "chartRepo": "ghcr.io/mutex-solutions/charts",
        "chartName": "database-cluster",
        "chartVersion": "0.1.0"
      },
      "database": {
        "storageClasses": [],
        "limits": { "maxCpu": 32, "maxMemoryGiB": 128, "maxStorageGiB": 2048 },
        "engines": {
          "postgresql": { "versions": ["16", "17", "18"], "default": "17", "replicas": [1, 2, 3] },
          "mysql":      { "versions": ["8.4"], "default": "8.4", "replicas": [1, 3] },
          "mariadb":    { "versions": ["10.11", "11.4"], "default": "11.4", "replicas": [1, 3] },
          "valkey":     { "versions": ["8.1"], "default": "8.1", "replicas": [1, 3], "beta": true },
          "ferretdb":   { "versions": ["2.5"], "default": "2.5", "replicas": [1, 2, 3] },
          "opensearch": { "versions": ["3.3.0"], "default": "3.3.0", "replicas": [1, 3] },
          "kafka":      { "versions": ["4.2.0", "4.2.1", "4.3.0"], "default": "4.3.0", "replicas": [3] }
        }
      }
    },
    "secret": {
      "kubeconfig": "__DBAAS_CLUSTER_KUBECONFIG__"
    }
  }
]
