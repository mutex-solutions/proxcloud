apiVersion: v1
kind: Namespace
metadata:
  name: {{ pc.namespace }}
---
# Read by the API (api.existingSecret). rabbitmq-password stays with the operator's own Secret.
# `data`, not `stringData`: kubectl apply reports stringData as changed on every run.
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-secrets
  namespace: {{ pc.namespace }}
type: Opaque
data:
  db-url: {{ ('postgres://proxcloud:' ~ (pc_db_password | urlencode) ~ '@proxcloud-pg-rw:5432/proxcloud?sslmode=require') | b64encode }}
  encryption-key: {{ pc_encryption_key | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-db-owner
  namespace: {{ pc.namespace }}
type: kubernetes.io/basic-auth
data:
  username: {{ 'proxcloud' | b64encode }}
  password: {{ pc_db_password | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-keycloak-db
  namespace: {{ pc.namespace }}
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
data:
  username: {{ 'keycloak' | b64encode }}
  password: {{ pc_keycloak_db_password | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-keycloak-admin
  namespace: {{ pc.namespace }}
type: Opaque
data:
  admin-password: {{ pc_keycloak_admin_password | b64encode }}
{% if pc.images.pull_secret %}
---
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-pull
  namespace: {{ pc.namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ {'auths': {pc.images.registry.split('/')[0]: {'username': pc.images.pull_secret.username, 'password': pc.images.pull_secret.password}}} | to_json | b64encode }}
{% endif %}
---
# ArgoCD's access to the chart repository.
apiVersion: v1
kind: Secret
metadata:
  name: proxcloud-charts
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
data:
  name: {{ 'proxcloud-charts' | b64encode }}
  type: {{ 'helm' | b64encode }}
  url: {{ pc_chart_repo | b64encode }}
  enableOCI: {{ 'true' | b64encode }}
{% if pc.images.build %}
  insecureOCIForceHttp: {{ 'true' | b64encode }}
{% elif pc.images.pull_secret %}
  username: {{ pc.images.pull_secret.username | b64encode }}
  password: {{ pc.images.pull_secret.password | b64encode }}
{% endif %}
