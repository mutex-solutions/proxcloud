{# The sandbox cluster as ArgoCD renders a tenant cluster, but in the platform's own namespace and pool, with no
   project label: no portal sync lists it and no project is billed for its workers (docs/managed-sandbox.md).
   No CSI token, no StorageClass, no NAS dataset: sandboxes use ephemeral storage only. #}
{% set sbx = pc.sandbox %}
{% set net = sbx.network %}
{% set images = pc.services.templates | dict2items | map(attribute='key') | zip(pc.services.templates | dict2items | map(attribute='value')) | map('join', '=') | join(',') %}
apiVersion: v1
kind: Namespace
metadata:
  name: pc-sandbox
---
apiVersion: v1
kind: Secret
metadata:
  name: pc-sandbox-cloud-config
  namespace: pc-sandbox
stringData:
  url: {{ pc_portal_pve_url }}
  token: {{ pc_sandbox_token_id }}
  secret: {{ pc_sandbox_token_secret }}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pc-sandbox
  namespace: argocd
  finalizers: [resources-finalizer.argocd.argoproj.io]
spec:
  project: proxcloud-k8s
  source:
    repoURL: {{ pc.services.chart_repo }}
    chart: proxmox-kamaji-cluster
    targetRevision: "{{ pc_chart_kamaji }}"
    helm:
      valuesObject:
        kubernetesVersion: "{{ pc.services.k8s_version }}"
        cloudCredentialsSecretName: pc-sandbox-cloud-config
        # kamajiControlPlane.admissionControllers stays the chart's list, NodeRestriction included; stage 55 checks it.
        kamajiControlPlane:
          replicas: 1
          dataStoreName: default
          network: {serviceType: LoadBalancer}
        clusterNetwork: {pods: 10.244.0.0/16, services: 10.96.0.0/12}
        proxmox:
          region: {{ pc.provider.region }}
          pool: {{ sbx.pool }}
          storage: {{ pc_sandbox_storage }}
          network:
            bridge: {{ net.vnet }}
            gateway: {{ net.gateway }}
            prefix: {{ net.subnet | split('/') | last | int }}
            addresses: {{ [net.nodes] | to_json }}
            dnsServers: {{ net.dns | to_json }}
            mtu: {{ net.mtu | int }}
          csi: {configSecretName: "", storageClasses: []}
          rwx: {server: "", share: "", storageClassName: shared-file}
          metallb:
            addresses: {{ [net.metallb] | to_json }}
            speakerTolerations: [{key: proxcloud.io/sandbox-system, operator: Exists, effect: NoSchedule}]
        nodeGroups:
          - name: sandbox
            machineFlavor: sandbox
            machineImageId: "{{ images }}"
            machineCores: {{ sbx.nodes.cores | int }}
            machineMemoryMiB: {{ sbx.nodes.memory | int }}
            machineRootVolume: {diskSize: {{ sbx.nodes.disk | int }}}
            machineTags: [proxcloud, pc-sandbox]
            machineCount: {{ sbx.nodes.count | int }}
            nodeLabels: {proxcloud.io/sandbox: cpu}
            # Off only through the portal's sync, once the worker's VM firewall is in place and the join token its disk
            # holds has expired (docs/managed-sandbox.md §2). NodeRestriction keeps the kubelet from dropping it.
            taints: [{key: proxcloud.io/unsecured, value: "true", effect: NoSchedule}]
{% if pc_sandbox_edge_on | bool %}
          # sandbox-proxy holds the wildcard key and the wake token, and a kubelet can read the Secrets of the pods on its
          # node: so the proxy runs here alone, never next to tenant code. The label is CAPI's to set (a kubelet cannot
          # claim it), the taint keeps sandboxes off. In the sandbox pool, so the sync fences these workers too.
          - name: sandbox-system
            machineFlavor: sandbox-system
            machineImageId: "{{ images }}"
            machineCores: {{ sbx.system_nodes.cores | int }}
            machineMemoryMiB: {{ sbx.system_nodes.memory | int }}
            machineRootVolume: {diskSize: {{ sbx.system_nodes.disk | int }}}
            machineTags: [proxcloud, pc-sandbox]
            machineCount: {{ sbx.system_nodes.count | int }}
            nodeLabels: {proxcloud.io/sandbox: system}
            machineLabels: {node-restriction.kubernetes.io/proxcloud-system: "true"}
            taints:
              - {key: proxcloud.io/unsecured, value: "true", effect: NoSchedule}
              - {key: proxcloud.io/sandbox-system, value: "true", effect: NoSchedule}
{% endif %}
        addons:
          metricsServer: {enabled: false}
          certManager: {enabled: false}
          ingress: {enabled: false}
  destination:
    server: https://kubernetes.default.svc
    namespace: pc-sandbox
  syncPolicy:
    automated: {prune: true, selfHeal: true}
