apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  chart: oci://ghcr.io/mutex-solutions/charts-mirror/argo-cd
  version: {{ pc_ver.argocd_chart }}
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    dex:
      enabled: false
    notifications:
      enabled: false
    applicationSet:
      replicas: 0
    configs:
      params:
        server.insecure: true
