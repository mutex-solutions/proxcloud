# Re-run the guard so a worker that joined, moved or had its firewall rebuilt by the portal's sync is
# pinned within a minute. A worker keeps its unsecured taint (no tenant pods) for 20 minutes, far
# longer than this, so a worker never runs tenant code before the guard covers it.
[Unit]
Description=Refresh the ProxCloud sandbox ICMP anti-spoof guard

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
