/bin/
*.exe
*.out
*.test
.env
vendor/

# Frontend
node_modules/
dist/

# Deployment value overlays — env-specific, may carry secrets. Keep LOCAL only.
# (deploy/charts/proxcloud/values.yaml + values-dev.yaml stay tracked — those are
# the chart defaults/sample, no secrets.)
/deploy/*values*.yaml

# Internal engineering log / pairing handoff — not for the public repo.
/CLAUDE.md

# Vendored Helm subchart archives — pulled by `helm dependency build` from Chart.lock.
/deploy/charts/*/charts/*.tgz

# Internal task log — not for the public repo.
/tasks/

# Internal migration working notes — not for the public repo.
/MIGRATION_PLAN.md
/_audit/

# Locally built API binaries — never commit.
/api
/proxcloud-api

__pycache__/
